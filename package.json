{
  "name": "premium-site-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "dev:full": "vercel dev",
    "build": "tsc --noEmit && vite build",
