    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@types/node": "^26.6.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vercel/node": "^13.0.2",
    "oxlint": "^1.66.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
